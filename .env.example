# InventaAPI release environment template — placeholders only.
# Node.js 22.x is the validated release toolchain. Provider compatibility must
# be confirmed before deployment. Never commit a populated .env file.
# Full purpose/format/requiredness: docs/release-environment.md

# -----------------------------------------------------------------------------
# Express backend — required for a production backend release
# -----------------------------------------------------------------------------
NODE_ENV=production
API_PORT=5000

# Supabase: data, sign-in and product photos. Supabase dashboard -> Project Settings.
# SUPABASE_DB_URL is the "Transaction pooler" connection string (port 6543).
# SUPABASE_SECRET_KEY (sb_secret_...) is server-only: never put it in a NEXT_PUBLIC_ value.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:REPLACE_IN_SECRET_STORE@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE
SUPABASE_SECRET_KEY=sb_secret_REPLACE_IN_SECRET_STORE

# Data identity label (the old name is kept): inventaapi-db = Production (LIVE payments),
# inventaapi-staging = staging (TEST payments). No Firebase project is used.
FIREBASE_PROJECT_ID=inventaapi-staging

# Daily jobs (Vercel Cron, see vercel.json): expire ended subscriptions, send Trial
# warnings. 16+ random characters; Vercel sends it to the jobs automatically.
CRON_SECRET=REPLACE_IN_SECRET_STORE

# TEST payments are permitted only against staging, even in a production runtime.
# Data label inventaapi-db requires LIVE mode and matching keys.
# The webhook signing secret must match the selected provider mode/endpoint.
PAYMONGO_MODE=test
# Initiation-only cutover control; does not pause status, webhooks or fulfillment.
# Absent/false preserves checkout flow. Activation requires separate release approval.
PAYMENT_CHECKOUT_INITIATION_HOLD=false
PAYMONGO_SECRET_KEY=sk_test_REPLACE_IN_SECRET_STORE
PAYMONGO_WEBHOOK_SECRET=REPLACE_WITH_ENDPOINT_SIGNING_SECRET
# 32+ random characters (e.g. `openssl rand -base64 48`). Seals new API key
# secrets so owners can copy them again; keys stay hashed for authentication.
# Changing it makes existing sealed copies unreadable (keys keep working).
API_KEY_ENCRYPTION_SECRET=REPLACE_IN_SECRET_STORE

# Signup email verification, API server ONLY. Never NEXT_PUBLIC.
# A new Customer account is created only after the 6-digit code emailed to the
# address is entered. Choose ONE provider:
#   smtp   - any SMTP mailbox, e.g. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
#            SMTP_USER=the Gmail address, SMTP_PASS=a Google App Password (needs
#            2-Step Verification; paste the 16 characters without spaces).
#   resend - RESEND_API_KEY plus an EMAIL_FROM on a domain verified in Resend.
# Local development only: with NODE_ENV=development and no provider, codes are
# printed to the API server log instead of being emailed.
EMAIL_DELIVERY_PROVIDER=smtp
EMAIL_FROM="InventaAPI <replace-with-sender@gmail.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=replace-with-sender@gmail.com
SMTP_PASS=REPLACE_WITH_APP_PASSWORD_IN_SECRET_STORE
# RESEND_API_KEY=re_REPLACE_IN_SECRET_STORE

# Optional temporary capstone billing, API server ONLY. Never NEXT_PUBLIC.
# Explicit true requires PAYMONGO_MODE=live and amount exactly 500. Defaults off.
# Website list prices remain unchanged; Hosted Checkout shows the actual charge.
PAYMONGO_GLOBAL_TEST_BILLING=false
PAYMONGO_GLOBAL_TEST_AMOUNT_CENTAVOS=500

# Canonical HTTPS origins: no trailing slash/path/query/fragment.
# Both variables must identify the same operator-supplied Customer origin.
DASHBOARD_URL=https://dashboard.example.com
NEXT_PUBLIC_APP_URL=https://dashboard.example.com

# Required operator decision for existing +30 runtime-local calendar-day behavior.
# Set to UTC or the approved IANA timezone; do not guess based on developer locale.
TZ=

# Optional. Canonical UTC: YYYY-MM-DDTHH:mm:ss.sssZ. A scheduled future value
# remains inactive (and quota initialization stays fail-closed) until that instant.
# Do not invent/backdate this value. Every backend instance must use one identical
# operator-approved value. Missing/invalid values intentionally use the fail-closed
# next-clean-UTC-window quota hold.
API_QUOTA_CUTOVER_AT=
# Optional, separate assertion for the new Free monthly policy. Never reuse or
# backdate the old daily cutover. Unset/invalid => next-UTC-month hold when no
# authoritative monthly counter exists. No production value is selected here.
FREE_MONTHLY_QUOTA_CUTOVER_AT=

# -----------------------------------------------------------------------------
# Customer dashboard and Admin panel — public build-time configuration
# These are identifiers, not secrets. Required values must be set explicitly;
# the Storage bucket below is optional for this URL-only image release.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.example.com
# Customer build only: fixed cross-app Admin /login destination (no token handoff).
NEXT_PUBLIC_ADMIN_APP_ORIGIN=https://admin.example.com
# Sign-in (Supabase Auth). The publishable key is public; never use the secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE

# NEXT_PUBLIC_SUPERADMIN_UID is no longer read by the R5A+ auth flow.

# VERCEL is provider-managed when applicable; do not set it to claim a target.

# Product photo uploads, API server ONLY, off unless "true". Photos are kept in the
# private Supabase Storage bucket below and served through the API.
PRODUCT_MEDIA_ENABLED=false
SUPABASE_MEDIA_BUCKET=product-media
# The API's public origin, used in published photo links.
PRODUCT_MEDIA_PUBLIC_ORIGIN=
