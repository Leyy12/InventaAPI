# =====================================================
# InventaAPI Environment Configuration
# Copy this file to .env and update with your values
# =====================================================

# API Server Configuration
API_PORT=5001
NODE_ENV=development

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inventaapi
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Firebase Admin SDK (for authentication)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# JWT Configuration (optional, for additional token generation)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=30d

# CORS Configuration
CORS_ORIGIN=*
# In production, set to specific domain: CORS_ORIGIN=https://yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# Frontend URL (for API responses)
FRONTEND_URL=http://localhost:3000

# Optional: Webhook endpoints for monitoring
WEBHOOK_URL_USAGE_ALERT=
WEBHOOK_URL_ERROR_ALERT=

# Optional: Email configuration (for notifications)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
