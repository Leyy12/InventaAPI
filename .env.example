# InventaAPI release environment template — placeholders only.
# Node.js 22.x is the validated release toolchain. Provider compatibility must
# be confirmed before deployment. Never commit a populated .env file.
# Full purpose/format/requiredness: docs/release-environment.md

# -----------------------------------------------------------------------------
# Express backend — required for a production backend release
# -----------------------------------------------------------------------------
NODE_ENV=production
API_PORT=5000

# Root backend currently supports environment service-account credentials.
# service_account_env: supply the three FIREBASE_* values below from a secret store.
# application_default is NOT implemented by the root initializer. Functions use
# their separate managed identity; do not copy these backend secrets to Functions.
FIREBASE_AUTH_MODE=service_account_env
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=service-account@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_IN_SECRET_STORE\n-----END PRIVATE KEY-----\n"

# Current capstone: production runtime, TEST payments, no real money.
# Live mode is deferred until separately authorized commercial launch.
# The webhook secret must belong to the PayMongo Test Mode endpoint.
PAYMONGO_MODE=test
PAYMONGO_SECRET_KEY=sk_test_REPLACE_IN_SECRET_STORE
PAYMONGO_WEBHOOK_SECRET=REPLACE_WITH_ENDPOINT_SIGNING_SECRET

# Canonical HTTPS origins: no trailing slash/path/query/fragment.
# Both variables must identify the same operator-supplied Customer origin.
DASHBOARD_URL=https://dashboard.example.com
NEXT_PUBLIC_APP_URL=https://dashboard.example.com

# Required operator decision for existing +30 runtime-local calendar-day behavior.
# Set to UTC or the approved IANA timezone; do not guess based on developer locale.
TZ=

# Optional. Canonical UTC: YYYY-MM-DDTHH:mm:ss.sssZ. A scheduled future value
# remains inactive (and quota initialization stays fail-closed) until that instant.
# Do not invent/backdate this value. Every backend instance must use one identical
# operator-approved value. Missing/invalid values intentionally use the fail-closed
# next-clean-UTC-window quota hold.
API_QUOTA_CUTOVER_AT=
# Optional, separate assertion for the new Free monthly policy. Never reuse or
# backdate the old daily cutover. Unset/invalid => next-UTC-month hold when no
# authoritative monthly counter exists. No production value is selected here.
FREE_MONTHLY_QUOTA_CUTOVER_AT=

# -----------------------------------------------------------------------------
# Customer dashboard and Admin panel — public build-time configuration
# These are identifiers, not secrets. Required values must be set explicitly;
# the Storage bucket below is optional for this URL-only image release.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.example.com
# Customer build only: fixed cross-app Admin /login destination (no token handoff).
NEXT_PUBLIC_ADMIN_APP_ORIGIN=https://admin.example.com
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
# OPTIONAL: public Web SDK bucket setting, not upload/deployment authorization.
# Leave empty for URL-only product images; storage.rules remains undeployed.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:replacewithappid

# NEXT_PUBLIC_SUPERADMIN_UID is no longer read by the R5A+ auth flow.

# VERCEL is provider-managed when applicable; do not set it to claim a target.
# No Firebase project alias, backend host, or frontend project is tracked yet.
