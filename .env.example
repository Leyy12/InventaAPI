# InventaAPI release environment template — placeholders only.
# Node.js 22.x is the validated release toolchain. Provider compatibility must
# be confirmed before deployment. Never commit a populated .env file.
# Full purpose/format/requiredness: docs/release-environment.md

# -----------------------------------------------------------------------------
# Express backend — required for a production backend release
# -----------------------------------------------------------------------------
NODE_ENV=production
API_PORT=5000

# Select exactly one Firebase Admin authentication path.
# service_account_env: supply the three FIREBASE_* values below from a secret store.
# application_default: omit those three values and use a verified managed identity.
FIREBASE_AUTH_MODE=service_account_env
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=service-account@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_IN_SECRET_STORE\n-----END PRIVATE KEY-----\n"

# Use sk_test_ only for sandbox validation and sk_live_ only after explicit
# production authorization. The webhook secret belongs to the matching endpoint.
PAYMONGO_SECRET_KEY=sk_live_REPLACE_IN_SECRET_STORE
PAYMONGO_WEBHOOK_SECRET=REPLACE_WITH_ENDPOINT_SIGNING_SECRET

# Absolute public URLs. Production values must be HTTPS and non-local.
DASHBOARD_URL=https://dashboard.example.com
NEXT_PUBLIC_APP_URL=https://dashboard.example.com

# Optional. Canonical UTC: YYYY-MM-DDTHH:mm:ss.sssZ. A scheduled future value
# remains inactive (and quota initialization stays fail-closed) until that instant.
# Do not invent/backdate this value. Every backend instance must use one identical
# operator-approved value. Missing/invalid values intentionally use the fail-closed
# next-clean-UTC-window quota hold.
API_QUOTA_CUTOVER_AT=

# -----------------------------------------------------------------------------
# Customer dashboard and Admin panel — public build-time configuration
# These are identifiers, not secrets, but production builds must set them explicitly.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:replacewithappid

# Customer dashboard only. Public Firebase Auth UID used by existing role logic.
NEXT_PUBLIC_SUPERADMIN_UID=replace-with-firebase-auth-uid

# VERCEL is provider-managed when applicable; do not set it to claim a target.
# No Firebase project alias, backend host, or frontend project is tracked yet.
