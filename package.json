{
  "name": "daas-sales-inventory-api",
  "version": "1.0.0",
  "description": "API-based Data-as-a-Service (DaaS) Engine for Multi-Business Sales and Inventory Management",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "validate:release-config": "node scripts/validate-release-config.mjs",
    "test:r0:config": "node --test tests/r0/release-config.test.mjs",
    "test:adviser:phase1": "node scripts/run-adviser-phase1-tests.mjs",
    "test:adviser:phase2a": "node scripts/run-adviser-phase2a-tests.mjs",
    "test:adviser:phase2a:rules": "node --test --test-reporter=spec scripts/test-adviser-phase2a-rules.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.1",
    "express-rate-limit": "^7.1.5",
    "firebase": "^10.12.2",
    "firebase-admin": "^11.11.1",
    "google-auth-library": "^11.0.0",
    "googleapis": "^173.0.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "playwright": "^1.62.1"
  }
}
