rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// FIRESTORE SECURITY RULES - InventaAPI (inventaapi-db)
// ═══════════════════════════════════════════════════════════════════════════
//
// FINAL VERSION v3 — Comprehensive coverage of all client-side collections
// Date: August 22, 2026
//
// Changes from v2:
// - users.create: strict enforcement (role=='Developer', plan=='Starter', apiRequestLimit==50)
// - Added categories collection: admin CRUD
// - Added system collection: admin read/write (settings page)
// - Added audit_logs collection: admin read-only (no client writes)
// - enterprise_inquiries and notifications rules retained from v2
//
// ALL collections the client writes to are now covered:
// Dashboard (customer):
//   ✅ users          — create own doc on signup
//   ✅ notifications  — create (to admin), update read flag
//   ✅ enterprise_inquiries — authenticated create
//
// Admin Panel:
//   ✅ products       — admin CRUD
//   ✅ product_requests — admin update (approve/reject)
//   ✅ categories     — admin CRUD
//   ✅ system         — admin read/write
//   ✅ notifications  — admin create, update, read
//   ✅ api_keys       — admin read (security page)
//   ✅ audit_logs     — admin read-only
//   ✅ transactions   — admin read-only (no client writes)
//
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────────────────────────────────────────────────────────────────
    // HELPER FUNCTIONS
    // ───────────────────────────────────────────────────────────────────────

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user is the document owner
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Check if user has admin role (case-insensitive)
    // Uses Admin SDK-written Firestore document as source of truth.
    function isAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role.lower() == 'admin';
    }

    // ───────────────────────────────────────────────────────────────────────
    // USERS COLLECTION
    // ───────────────────────────────────────────────────────────────────────

    match /users/{userId} {
      // PRIVACY FIX: Users can only read their own document; Admins can read all
      allow read: if isOwner(userId) || isAdmin();

      // Signup: Must provide exact Developer/Starter/50 values.
      // Prevents privilege escalation at registration.
      // No bootstrap-via-email branch exists here.
      allow create: if isAuthenticated()
                    && request.auth.uid == userId
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.role == 'Developer'
                    && request.resource.data.plan == 'Free'
                    && request.resource.data.apiRequestLimit == 50;

      // Users can update their own document but CANNOT change:
      //   - uid         (identity)
      //   - role        (privilege — prevent self-escalation)
      //   - plan        (subscription tier — managed by webhook via Admin SDK)
      //   - apiRequestLimit (quota — managed by webhook via Admin SDK)
      //   - subscriptionExpiresAt (expiry date — managed by webhook via Admin SDK)
      //
      // Using .get() ensures this rule doesn't crash if the field is missing.
      // Admin SDK writes (webhook, scheduled downgrade) bypass these rules entirely.
      allow update: if isOwner(userId)
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.get('plan', '') == resource.data.get('plan', '')
                    && request.resource.data.get('apiRequestLimit', 0) == resource.data.get('apiRequestLimit', 0)
                    && request.resource.data.get('subscriptionExpiresAt', '') == resource.data.get('subscriptionExpiresAt', '');

      // Only admins can delete user documents
      allow delete: if isAdmin();
    }

    // ───────────────────────────────────────────────────────────────────────
    // PRODUCTS COLLECTION
    // ───────────────────────────────────────────────────────────────────────

    match /products/{productId} {
      // Products are publicly readable (this is a Data-as-a-Service API)
      // DaaS consumers access product data via API keys (for rate limiting),
      // not for access control. The catalog itself is public.
      allow read: if true;

      // Only admins can create/update/delete products
      allow create, update, delete: if isAdmin();
    }

    // ───────────────────────────────────────────────────────────────────────
    // PRODUCT REQUESTS COLLECTION
    // ───────────────────────────────────────────────────────────────────────

    match /product_requests/{requestId} {
      // Users can read their own requests; admins can read all
      allow read: if isOwner(resource.data.userId) || isAdmin();

      // Users can create requests with their own userId
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid;

      // Users can update their own pending requests;
      // Admins can update any request (approve/reject)
      allow update: if isOwner(resource.data.userId) || isAdmin();

      // Only admins can delete requests
      allow delete: if isAdmin();
    }

    // ───────────────────────────────────────────────────────────────────────
    // API KEYS COLLECTION
    // ───────────────────────────────────────────────────────────────────────
    // NOTE: All current operations go through the backend (Admin SDK),
    // so these rules are defense-in-depth for any future client-side access.

    match /api_keys/{keyId} {
      // Users can read their own API keys; admins can read all
      allow read: if isOwner(resource.data.userId) || isAdmin();

      // Users can create their own API keys
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid;

      // Users can update their own API keys (e.g. rename, revoke)
      allow update: if isOwner(resource.data.userId) || isAdmin();

      // Users can delete their own API keys
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ───────────────────────────────────────────────────────────────────────
    // TRANSACTIONS COLLECTION
    // ───────────────────────────────────────────────────────────────────────
    // Created exclusively by the PayMongo webhook handler (Admin SDK).
    // No client-side writes are ever permitted.

    match /transactions/{transactionId} {
      // Users can read their own transaction history; admins can read all
      allow read: if isOwner(resource.data.userId) || isAdmin();

      // No client-side writes — EVER. Admin SDK (webhook) handles all writes.
      allow create, update, delete: if false;
    }

    // ───────────────────────────────────────────────────────────────────────
    // ENTERPRISE INQUIRIES COLLECTION
    // ───────────────────────────────────────────────────────────────────────
    // Submitted via the Enterprise Contact Sales form.
    // Authenticated users can submit inquiries; only admins can view/manage.

    match /enterprise_inquiries/{inquiryId} {
      // Only admins can read enterprise inquiries
      allow read: if isAdmin();

      // Any authenticated user can create an inquiry
      // Validate required fields are present and non-empty
      allow create: if isAuthenticated()
                    && request.resource.data.fullName is string
                    && request.resource.data.fullName.size() > 0
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 0
                    && request.resource.data.company is string
                    && request.resource.data.company.size() > 0
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0;

      // Only admins can update inquiries (e.g., change status to 'contacted')
      allow update: if isAdmin();

      // Only admins can delete inquiries
      allow delete: if isAdmin();
    }

    // ───────────────────────────────────────────────────────────────────────
    // NOTIFICATIONS COLLECTION
    // ───────────────────────────────────────────────────────────────────────
    // userId == "admin"  → only admins can read
    // userId == <uid>    → only that user can read
    // Any authenticated user (customer) can CREATE a notification addressed
    //   to "admin" (e.g., product request submitted).
    // Admins can create any notification (approve / reject callbacks).
    // Only the recipient or an admin can mark read (update).

    match /notifications/{notifId} {
      // 1. A user can read their own notifications
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // 2. Admins can read notifications addressed to "admin"
      allow read: if isAuthenticated() && resource.data.userId == "admin" && isAdmin();
      
      // 3. Admins can read all notifications (fallback)
      allow read: if isAdmin();

      // Create:
      //   - Authenticated customers can create notifications addressed to "admin"
      //   - Admins can create notifications for any userId (approval / rejection)
      allow create: if isAuthenticated()
        && (
          (request.resource.data.userId == "admin")
          || isAdmin()
        );

      // Update (mark read): only the recipient or an admin
      allow update: if isAuthenticated()
        && (
          resource.data.userId == request.auth.uid
          || (resource.data.userId == "admin" && isAdmin())
          || isAdmin()
        )
        // Only allow toggling the `read` field
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"]);

      allow delete: if isAdmin();
    }

    // ───────────────────────────────────────────────────────────────────────
    // CATEGORIES COLLECTION
    // ───────────────────────────────────────────────────────────────────────
    // Managed exclusively by admins via the admin panel.
    // No customer-facing reads or writes needed.

    match /categories/{categoryId} {
      // Only admins can read, create, update, or delete categories
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ───────────────────────────────────────────────────────────────────────
    // SYSTEM COLLECTION
    // ───────────────────────────────────────────────────────────────────────
    // Used for global system settings (admin settings page).
    // Only admins can read or write.

    match /system/{docId} {
      allow read, write: if isAdmin();
    }

    // ───────────────────────────────────────────────────────────────────────
    // AUDIT LOGS COLLECTION
    // ───────────────────────────────────────────────────────────────────────
    // Written exclusively via Admin SDK (server-side logging).
    // Admins can read for audit/compliance. No client writes ever.

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ───────────────────────────────────────────────────────────────────────
    // DEFAULT DENY
    // ───────────────────────────────────────────────────────────────────────

    // Deny all other reads/writes not matched above
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
