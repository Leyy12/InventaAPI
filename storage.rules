rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// FIREBASE STORAGE SECURITY RULES - InventaAPI (inventaapi-db)
// ═══════════════════════════════════════════════════════════════════════════
//
// Version: v1
// Date: August 3, 2026
//
// Purpose: Secure product image uploads while allowing public read access
// for DaaS catalog display.
//
// Security Model:
// - Product images: PUBLIC READ (needed for catalog UI), ADMIN-ONLY WRITE
// - Write constraints: 2MB max, images only, authenticated admins only
//
// ═══════════════════════════════════════════════════════════════════════════

service firebase.storage {
  match /b/{bucket}/o {
    
    // ───────────────────────────────────────────────────────────────────────
    // PRODUCT IMAGES
    // ───────────────────────────────────────────────────────────────────────
    // Path: /products/{timestamp}_{filename}
    // Example: /products/1735890123456_bear-brand.jpg
    //
    // PUBLIC READ: Images must be accessible in public catalog UI and via
    // DaaS API responses (similar to current Unsplash URLs).
    //
    // ADMIN-ONLY WRITE: Only authenticated admin users can upload to prevent
    // spam/abuse. Enforces 2MB limit and image-only content types.
    
    match /products/{imageId} {
      // Anyone can read product images (public catalog)
      allow read: if true;
      
      // Only authenticated admins can upload product images
      allow write: if request.auth != null 
                   && exists(/databases/$(database)/documents/users/$(request.auth.uid))
                   && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role.lower() == 'admin'
                   && request.resource.size < 2 * 1024 * 1024  // 2MB max file size
                   && request.resource.contentType.matches('image/.*');  // Images only (jpeg, png, webp, etc.)
    }
    
    // ───────────────────────────────────────────────────────────────────────
    // DEFAULT DENY
    // ───────────────────────────────────────────────────────────────────────
    // Deny all access to other paths not explicitly matched above
    
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
