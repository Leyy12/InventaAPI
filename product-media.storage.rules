rules_version = '2';
// Proposed backend-only managed media. LOCAL EMULATOR VALIDATION ONLY.
// Admin SDK uses bucket IAM; all client Storage SDK access is denied, including
// client-provided role claims. The API verifies current Firestore authority.
// No Firebase download tokens or public staging objects are created.
service firebase.storage {
  match /b/{bucket}/o {
    match /{object=**} {
      allow read, write: if false;
    }
  }
}
